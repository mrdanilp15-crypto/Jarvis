# Kopieren nach deploy/.env und ausfüllen. Niemals committen.
POSTGRES_PASSWORD=change-me
JARVIS_CONFIG_FILE=jarvis.example.yaml

# Lokales Sprachmodell (leer = aus der Konfiguration). start.sh trägt hier ein Modell passend zur Hardware ein:
# NVIDIA-GPU ab 11 GB: qwen2.5:14b-instruct · ab 6 GB bzw. ohne GPU mit genug RAM: qwen2.5:7b-instruct · sonst 3b
JARVIS_LLM_MODEL=
# Mit NVIDIA-GPU (setzt start.sh automatisch):
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# COMPOSE_PATH_SEPARATOR=:

# Standardort fürs Wetter (die Weboberfläche kann einen eigenen Ort mitsenden)
JARVIS_HOME_LOCATION=

# Cloud-LLM (optional – ohne Schlüssel arbeitet JARVIS nur mit dem lokalen Modell)
ANTHROPIC_API_KEY=

# Referenzcode löst vault:-Referenzen über JARVIS_SECRET_<PFAD>_<FELD> auf
JARVIS_SECRET_KV_JARVIS_HOMEASSISTANT_TOKEN=
JARVIS_SECRET_KV_JARVIS_MQTT_PASSWORD=

# Entwicklungs-Tokens für die API (Betrieb: OIDC)
JARVIS_DEV_TOKENS={"dev-alex-token": {"actor": "user:alex", "role": "adult", "trust": "trusted_user"}}

# Node-RED -> JARVIS
NODERED_JARVIS_TOKEN=
