# Kopieren nach deploy/.env und ausfüllen. Niemals committen.
POSTGRES_PASSWORD=change-me
JARVIS_CONFIG_FILE=jarvis.example.yaml

# Cloud-LLM (optional – ohne Schlüssel arbeitet JARVIS nur mit dem lokalen Modell)
ANTHROPIC_API_KEY=

# Referenzcode löst vault:-Referenzen über JARVIS_SECRET_<PFAD>_<FELD> auf
JARVIS_SECRET_KV_JARVIS_HOMEASSISTANT_TOKEN=
JARVIS_SECRET_KV_JARVIS_MQTT_PASSWORD=

# Entwicklungs-Tokens für die API (Betrieb: OIDC)
JARVIS_DEV_TOKENS={"dev-alex-token": {"actor": "user:alex", "role": "adult", "trust": "trusted_user"}}

# Node-RED -> JARVIS
NODERED_JARVIS_TOKEN=
