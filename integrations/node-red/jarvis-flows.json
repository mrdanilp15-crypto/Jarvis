  {
    "id": "c_washer",
    "type": "comment",
    "z": "tab_jarvis",
    "name": "2) Waschmaschine fertig -> Event an JARVIS (Proaktiv-Engine)",
    "info": "",
    "x": 270,
    "y": 160,
    "wires": []
  },
  {
    "id": "in_washer",
    "type": "mqtt in",
    "z": "tab_jarvis",
    "name": "Steckdose Waschmaschine",
    "topic": "zigbee2mqtt/steckdose_waschmaschine",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_jarvis",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 170,
    "y": 200,
    "wires": [
      [
        "fn_washer"
      ]
    ]
  },
  {
    "id": "fn_washer",
    "type": "function",
    "z": "tab_jarvis",
    "name": "Leistungsabfall erkennen",
    "func": "// Fertig = Leistung fällt nach Laufphase (> 50 W) für eine Messung unter 3 W\nconst running = context.get('running') || false;\nconst power = Number(msg.payload.power);\nif (power > 50) { context.set('running', true); return null; }\nif (!running || power >= 3) return null;\ncontext.set('running', false);\nmsg.url = env.get('JARVIS_CORE_URL') + '/v1/events';\nmsg.headers = { authorization: 'Bearer ' + env.get('JARVIS_TOKEN'), 'content-type': 'application/json' };\nmsg.payload = {\n  specversion: '1.0', source: '/nodered/waschmaschine', type: 'jarvis.home.appliance_finished',\n  subject: 'switch.steckdose_waschmaschine', data: { appliance: 'waschmaschine' }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 200,
    "wires": [
      [
        "http_event"
      ]
    ]
  },
  {
    "id": "http_event",
    "type": "http request",
    "z": "tab_jarvis",
    "name": "POST /v1/events",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 630,
