  {
    "id": "fn_summary",
    "type": "function",
    "z": "tab_jarvis",
    "name": "Kurzfassung",
    "func": "const d = msg.payload.data;\nmsg.payload = `${d.capability} -> ${d.status} (${d.decision.risk_class}) von ${msg.payload.actor}`;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 80,
