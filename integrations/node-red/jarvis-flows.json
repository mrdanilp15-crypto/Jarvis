  {
    "id": "c_cmd",
    "type": "comment",
    "z": "tab_jarvis",
    "name": "3) Kommandos von JARVIS (Capability garden.irrigation)",
    "info": "",
    "x": 250,
    "y": 280,
    "wires": []
  },
  {
    "id": "in_cmd",
    "type": "mqtt in",
    "z": "tab_jarvis",
    "name": "jarvis/v1/cmd/nodered",
    "topic": "jarvis/v1/cmd/nodered",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_jarvis",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 320,
    "wires": [
      [
        "sw_cmd"
      ]
    ]
  },
  {
    "id": "sw_cmd",
    "type": "switch",
    "z": "tab_jarvis",
    "name": "Kommando",
    "property": "payload.command",
    "propertyType": "msg",
    "rules": [
      {
        "t": "eq",
        "v": "irrigation_start",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "irrigation_stop",
        "vt": "str"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 3,
    "x": 360,
    "y": 320,
    "wires": [
      [
        "fn_valve"
      ],
      [
        "fn_valve"
      ],
      [
        "fn_ack"
      ]
    ]
  },
  {
    "id": "fn_valve",
    "type": "function",
    "z": "tab_jarvis",
    "name": "Ventil setzen + Quittung",
    "func": "const start = msg.payload.command === 'irrigation_start';\nconst minutes = Math.min(Number(msg.payload.minutes || 10), 30); // Sicherheitsgrenze\nconst valve = { topic: 'zigbee2mqtt/ventil_garten/set',\n  payload: start ? { state: 'ON', on_time: minutes * 60 } : { state: 'OFF' } };\nconst ack = { topic: 'jarvis/v1/state/nodered/ack',\n  payload: { request_id: msg.payload.request_id, ok: true, command: msg.payload.command } };\nreturn [valve, ack];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 580,
    "y": 300,
    "wires": [
      [
        "out_mqtt"
      ],
      [
        "out_mqtt"
      ]
    ]
  },
  {
    "id": "fn_ack",
    "type": "function",
    "z": "tab_jarvis",
    "name": "Unbekanntes Kommando",
    "func": "msg.topic = 'jarvis/v1/state/nodered/ack';\nmsg.payload = { request_id: msg.payload.request_id, ok: false, error: 'unknown_command' };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 580,
    "y": 360,
    "wires": [
      [
        "out_mqtt"
      ]
    ]
  },
