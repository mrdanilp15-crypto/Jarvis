{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jarvis.local/v1/error.schema.json",
  "title": "Problem",
  "description": "Fehlerformat nach RFC 9457 (Problem Details) mit JARVIS-Erweiterungen. Wird von REST-API, Plugin-Protokoll und Tool-Results verwendet.",
  "type": "object",
  "required": ["type", "title", "code", "category", "retryable"],
  "properties": {
    "type": { "type": "string", "format": "uri-reference", "description": "z. B. https://docs.jarvis.local/errors/device-unavailable" },
    "title": { "type": "string" },
    "status": { "type": "integer", "minimum": 400, "maximum": 599 },
    "detail": { "type": "string" },
    "instance": { "type": "string" },
    "code": { "type": "string", "pattern": "^JRV-[A-Z]{3,5}-[0-9]{3}$", "description": "Stabiler Fehlercode, z. B. JRV-DEV-001." },
    "category": {
      "enum": ["validation", "auth", "policy", "not_found", "conflict", "device", "integration", "llm", "timeout", "rate_limit", "internal"]
    },
    "retryable": { "type": "boolean" },
    "retry_after_ms": { "type": "integer", "minimum": 0 },
    "correlation_id": { "type": "string" },
    "user_message": { "type": "string", "description": "Kurze, verständliche Formulierung für Sprach-/Textausgabe." },
    "errors": {
      "type": "array",
      "description": "Feldbezogene Validierungsfehler.",
      "items": {
        "type": "object",
        "required": ["pointer", "message"],
        "properties": {
          "pointer": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
